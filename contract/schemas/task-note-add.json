{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t8nax/gentry/contract/schemas/task-note-add.json",
  "title": "TaskNoteAddOutput",
  "description": "Output of `gentry task note add --json`.",
  "type": "object",
  "properties": {
    "task": {
      "description": "Identifier of the task, such as SHOP-1.",
      "type": "string",
      "minLength": 1
    },
    "note": {
      "description": "The note added.",
      "$ref": "./task-note.json"
    }
  },
  "required": [
    "task",
    "note"
  ]
}
