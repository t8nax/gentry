{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t8nax/gentry/contract/schemas/task-note-list.json",
  "title": "TaskNoteListOutput",
  "description": "Output of `gentry task note list --json`.",
  "type": "object",
  "properties": {
    "task": {
      "description": "Identifier of the task, such as SHOP-1.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "Notes of the task by number.",
      "type": "array",
      "items": {
        "$ref": "./task-note.json"
      }
    }
  },
  "required": ["task", "notes"]
}
