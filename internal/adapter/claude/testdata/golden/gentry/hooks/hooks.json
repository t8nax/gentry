{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"/opt/Gentry Tools/gentry\" hook post-tool",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "\"/opt/Gentry Tools/gentry\" hook post-tool",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"/opt/Gentry Tools/gentry\" hook pre-tool",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"/opt/Gentry Tools/gentry\" hook session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"/opt/Gentry Tools/gentry\" hook stop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
